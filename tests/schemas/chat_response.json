{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatResponse",
  "description": "Schema for /api/chat response",
  "type": "object",
  "required": [
    "node_id",
    "action",
    "reason"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^resp-[a-f0-9]+$"
    },
    "action": {
      "type": "string",
      "enum": [
        "start",
        "queued",
        "scheduled",
        "reject"
      ]
    },
    "reason": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
